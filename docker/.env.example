# 复制为 docker/.env 后填写；不要将真实配置提交到 Git。
# 默认端口只绑定宿主机回环地址，公开访问请使用反向代理。
INFRA_IMAGE=infra-parent:local
INFRA_BIND_ADDRESS=127.0.0.1
INFRA_PORT=9000

# 一键体验默认使用 mysql 服务；已有数据库时替换为实际地址和库名。
DB_URL=jdbc:mysql://mysql:3306/infra?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_USERNAME=infra
DB_PASSWORD=
# 仅使用可选 MySQL 容器时需要；必须和应用账号密码不同。
MYSQL_ROOT_PASSWORD=

# Spring Data Redis 与 Redisson 共用以下连接信息。
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# 分别使用 openssl rand -base64 32 生成并长期备份，三个值不要相同。
UPM_SSO_SECRET_KEY=
UPM_API_SECRET_KEY=
SHORTLINK_MASTER_KEY=
